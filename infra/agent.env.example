# Copy to infra/agent.env (gitignored). Read by the `agent` container only.
# Without these the agent runs in STUB mode (no real conversation).

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=

# auto = live when all keys above are set, else stub | live = fail loudly if a key is missing | stub
AGENT_MODE=auto
# AGENT_LLM_MODEL=gpt-4o-mini
# To use Claude instead: AGENT_LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY=...
# AGENT_STT_LANGUAGE=en-IN
# AGENT_TTS_VOICE=<cartesia voice id>
# AGENT_MAX_CALL_SECONDS=300
