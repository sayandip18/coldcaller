# Copy to infra/carrier.env (gitignored). Read by the `asterisk` container only.
# Everything here comes from the carrier (Pulse / ConnectHub); see docs/going-live.md for what to ask.
# Left unset, Asterisk dials the local sipp test container instead.

PULSE_HOST=sip.carrier.example      # carrier SIP host or IP
PULSE_PORT=5060

# How the carrier authenticates us:
#   ip        they whitelist our public IP, no password (most common for wholesale trunks)
#   userpass  username/password on each INVITE
#   register  we REGISTER to them, then call
PULSE_AUTH=ip
# PULSE_USERNAME=
# PULSE_PASSWORD=

# Number format the carrier expects for the called number:
DIAL_KEEP_PLUS=yes     # yes: +919876543210   no: 919876543210
# DIAL_PREFIX=         # prepended after that, e.g. 0 or a trunk access code

# PULSE_SEND_PAI=no    # yes: also send P-Asserted-Identity with the caller ID (some carriers need it)
# RING_SECONDS=45

# Only for a real deployment:
# LIVEKIT_SIP_MATCH=203.0.113.10   # the LiveKit SIP service's address (default allows Docker networks)
# EXTERNAL_ADDRESS=198.51.100.7    # this host's public IP, if Asterisk is behind NAT
# LOCAL_NET=10.0.0.0/8
# RTP_START=30000
# RTP_END=30100                    # open these UDP ports to the carrier
