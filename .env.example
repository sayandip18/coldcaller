# Copy to apps/api/.env (gitignored) and adjust.
DATABASE_URL=postgresql+psycopg://coldcaller:coldcaller@localhost:5432/coldcaller
TEST_DATABASE_URL=postgresql+psycopg://coldcaller:coldcaller@localhost:5432/coldcaller_test
REDIS_URL=redis://localhost:6380/0
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# --- Phase 3: real calls through LiveKit (default is DIALER=fake, no LiveKit needed) ---
# DIALER=livekit
# LIVEKIT_SIP_TRUNK_ID=ST_xxxx        # from `pnpm livekit-trunk create ...`
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-devsecret
# AGENT_SHARED_SECRET=change-me       # must match the agent container (see docker-compose)
